<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Book Info Card (Non-editable) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/md_theme_surfaceVariant">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_show_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:src="@drawable/ic_details"
                    android:backgroundTint="@color/md_theme_tertiary"
                    app:tint="@color/md_theme_onPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Book Cover -->
                    <ImageView
                        android:id="@+id/bookEditCover"
                        android:layout_width="100dp"
                        android:layout_height="150dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Book cover"
                        android:background="@drawable/book_cover_background" />

                    <!-- Title and Author Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/bookEditTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:fontFamily="@font/adamina_regular"
                            android:text="Book Title" />

                        <TextView
                            android:id="@+id/bookEditAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="16sp"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:fontFamily="@font/adamina_regular"
                            android:text="Author Name" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Editable Fields Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Book Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_primary"
                android:fontFamily="@font/adamina_regular"
                android:layout_marginBottom="16dp" />

            <!-- Series Field with Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Series"
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:fontFamily="@font/adamina_regular"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="@color/md_theme_primary"
                app:hintTextColor="@color/md_theme_primary"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bookEditSeries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adamina_regular"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Number in Series Field with Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Number in Series"
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:fontFamily="@font/adamina_regular"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="@color/md_theme_primary"
                app:hintTextColor="@color/md_theme_primary"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bookEditNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adamina_regular"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Genre Dropdown -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Genre"
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:fontFamily="@font/adamina_regular"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                <Spinner
                    android:id="@+id/bookEditGenre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_background"
                    android:padding="8dp"
                    android:spinnerMode="dropdown" />
            </androidx.cardview.widget.CardView>

            <!-- Age Range Dropdown -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Age Range"
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:fontFamily="@font/adamina_regular"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                <Spinner
                    android:id="@+id/bookEditAgeRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_background"
                    android:padding="8dp"
                    android:spinnerMode="dropdown" />
            </androidx.cardview.widget.CardView>

            <!-- Categories Field with Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:fontFamily="@font/adamina_regular"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:boxStrokeColor="@color/md_theme_primary"
                app:hintTextColor="@color/md_theme_primary"
                app:helperText="Enter categories separated by commas"
                app:helperTextTextColor="@color/md_theme_onSurfaceVariant"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/bookEditCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adamina_regular"
                    android:inputType="text"
                    android:text="Current categories" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookEditSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Update"
                android:textSize="16sp"
                android:textColor="@color/md_theme_onPrimary"
                android:fontFamily="@font/adamina_regular"
                android:backgroundTint="@color/md_theme_tertiary"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/book_details_bottom_sheet"
        layout="@layout/layout_book_details_bottom_sheet" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>