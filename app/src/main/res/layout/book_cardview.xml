<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:backgroundTint="@color/md_theme_surfaceVariant"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:contentPadding="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="50dp"
            android:layout_height="75dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/book_cover_background" />

        <LinearLayout
            android:id="@+id/collapsedLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_marginLeft="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coverImage"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                android:fontFamily="@font/adamina_regular"
                android:text="Book Title" />

            <TextView
                android:id="@+id/textSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:fontFamily="@font/adamina_regular"
                android:textSize="14sp"
                android:textStyle="italic"
                android:text="SeriesName Number" />

            <TextView
                android:id="@+id/textAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface"
                android:fontFamily="@font/adamina_regular"
                android:text="FirstName LastName"/>

        </LinearLayout>

        <!-- Expanded content - initially hidden -->
        <LinearLayout
            android:id="@+id/expandedLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coverImage"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                android:fontFamily="@font/adamina_regular"
                android:text="Book Title" />

            <TextView
                android:id="@+id/textSeries2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:fontFamily="@font/adamina_regular"
                android:textSize="14sp"
                android:textStyle="italic"
                android:text="SeriesName Number" />


            <TextView
                android:id="@+id/textAuthor2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface"
                android:fontFamily="@font/adamina_regular"
                android:text="FirstName LastName"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md_theme_outline"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textBookPubYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Published: "
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:fontFamily="@font/adamina_regular"
                android:textSize="14sp"
                />

            <TextView
                android:id="@+id/textBookGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Genre: "
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:fontFamily="@font/adamina_regular"
                android:textSize="14sp"
                />

            <TextView
                android:id="@+id/textBookAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Age: "
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:fontFamily="@font/adamina_regular"
                android:textSize="14sp"
                />

            <TextView
                android:id="@+id/textBookThemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tags: "
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:fontFamily="@font/adamina_regular"
                android:textSize="14sp"
                android:textStyle="italic"
                />

        </LinearLayout>

        <!-- Add more expanded content views as needed -->

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>